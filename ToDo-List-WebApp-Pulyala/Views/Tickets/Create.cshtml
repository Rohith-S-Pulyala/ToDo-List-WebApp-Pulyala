@using ToDo_List_WebApp_Pulyala.Enums
@model ToDo_List_WebApp_Pulyala.Models.Ticket

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Ticket</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SprintNumber" class="control-label"></label>
                <input asp-for="SprintNumber" class="form-control" />
                <span asp-validation-for="SprintNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PointValue" class="control-label"></label>
                <input asp-for="PointValue" class="form-control" />
                <span asp-validation-for="PointValue" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<TicketStatus>()"> @*List of statuses to add into the ticket via Enum*@
                    <option value="">-- Change Status --</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="Add to Backlog" class="btn btn-success" />
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to Board</a>
                <a asp-controller="Tickets" asp-action="Index" class="btn btn-outline-secondary">Back to Index</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
