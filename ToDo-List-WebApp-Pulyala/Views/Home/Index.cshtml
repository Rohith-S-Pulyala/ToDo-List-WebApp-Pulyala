@using ToDo_List_WebApp_Pulyala.Enums
@model IEnumerable<ToDo_List_WebApp_Pulyala.Models.Ticket>


<h2>Agile Ticket Board</h2>

<div class="row">
    <div class="col-md-3">
        @*Filters to decide Sprint and Status*@
        <form asp-action="Filter" method="post">
            <div class="mb-3">
                <label class="form-label">Sprint:</label>
                <select name="sprint" class="form-select" asp-items="@(new SelectList(ViewBag.Sprints, ViewBag.Filters?.SprintId))"> @*Dropdown selection to choose Tickets at a certain sprint number.*@
                    <option value="all" selected="@(ViewBag.Filters?.SprintId == "all")">All Sprints</option> @*Placeholder to show all Sprints*@
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Status:</label>
                <select name="status" class="form-select" asp-items="@(new SelectList(ViewBag.Statuses, ViewBag.Filters.StatusId))"> @*Dropdown selection to choose Tickets at a certain status.*@
                    <option value="all" selected="@(ViewBag.Filters?.StatusId == "all")">All Statuses</option>@*Placeholder to show all Statuses*@
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Apply Filters</button> @*Button to apply the selected filters*@
            <a asp-action="Index" asp-route-id="all-all" class="btn btn-outline-secondary">Clear</a> @*Button to set filters to default.*@
        </form>
    </div>

    <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Current Sprint Board</h3>
            <a asp-controller="Tickets" asp-action="Create" class="btn btn-success">
                + Create New Agile Ticket 
            </a> @*Button to create new Agile Ticket*@
        </div>


        <form asp-action="UpdateStatus" method="post" asp-route-filter="@ViewBag.Filters.FilterString"> @*Action in HomeController UpdateStatus used*@
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Ticket Name</th>
                        <th>Sprint</th>
                        <th>Points</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Ticket ticket in Model)
                    {
                        <tr>
                            <td>@ticket.Name</td>
                            <td>@ticket.SprintNumber</td>
                            <td>@ticket.PointValue</td>
                            <td>
                                <span class="badge @(ticket.Status == TicketStatus.Done ? "bg-success" :
                                                     ticket.Status == TicketStatus.QA ? "bg-warning text-dark" :
                                                     ticket.Status == TicketStatus.InProgress ? "bg-primary" : "bg-secondary")">
                                    @ticket.Status
                                </span> @*Values changed to Enum*@
                            </td>
                            <td>
                                @*Calls ViewComponent*@
                                <vc:advance-status ticket="ticket"></vc:advance-status>
                            </td>
                            
                        </tr>
                    }
                </tbody>
            </table>
        </form>
    </div>
</div>
